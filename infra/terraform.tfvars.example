# Copy to terraform.tfvars for local runs (git-ignored), or set the
# equivalent TF_VAR_* env vars in CI. Never commit real terraform.tfvars.

aws_region               = "ap-south-1"
project_name             = "jenkins"
instance_type             = "t3.medium"
root_volume_size          = 20
jenkins_data_volume_size  = 20

# Restrict this to your own IP once you know it, e.g. "1.2.3.4/32"
jenkins_admin_cidr = "0.0.0.0/0"

# Leave null to use SSM Session Manager only (recommended, no open SSH port).
# ssh_key_name = "my-ec2-keypair"
# ssh_cidr     = "1.2.3.4/32"
